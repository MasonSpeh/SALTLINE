; SPRINT AND CROUCH SWAPPED, 4194325 (Shift) <-> 4194326 (Ctrl). Owner: "it should be shift
; to crouch instead of control". Shift was not free — it has been sprint since the map was
; written — so this is a SWAP, not a claim: sprint moves to Ctrl rather than losing its key.
; Both stay on a modifier next to the movement hand, which is the property that made the
; original pair work. player_controller._ensure_posture_bindings() carries the same Shift as
; its runtime fallback, so a stripped project.godot still crouches on the right key.
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
