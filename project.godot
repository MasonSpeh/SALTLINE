; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited.
;
; It won't be regenerated if deleted.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SALTLINE"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://scripts/autoload/game_clock.gd"
PowerGrid="*res://scripts/autoload/power_grid.gd"
PlayerState="*res://scripts/autoload/player_state.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
DEBUG="*res://scripts/autoload/debug.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

