; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SALTLINE"
run/main_scene="res://scenes/StartScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameClock="*res://scripts/autoload/game_clock.gd"
PowerGrid="*res://scripts/autoload/power_grid.gd"
PlayerState="*res://scripts/autoload/player_state.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
Journal="*res://scripts/autoload/journal.gd"
DEBUG="*res://scripts/autoload/debug.gd"
Ambience="*res://scripts/world/ambience.gd"
WorldStorage="*res://scripts/components/world_storage.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

