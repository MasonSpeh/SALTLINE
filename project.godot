[physics]

common/physics_ticks_per_second=30
3d/physics_engine="JoltPhysics3D"
; GHOST COLLISIONS — the single biggest cause of "the player keeps catching on nothing".
; Almost every collider on this rig is a CSGBox3D with use_collision, and CSG bakes its
; collision as a ConcavePolygonShape3D: a soup of triangles, not a box. Sliding a capsule
; across one, the solver keeps finding the INTERNAL edge between two coplanar triangles and
; reporting it as a contact with a bogus normal — the body stops on a perfectly flat deck
; plate, or refuses to round a railing corner, for geometry that has no corner there at all.
; Jolt can detect and ignore those internal edges; Godot just ships it off by default.
; motion_queries is the one that matters for CharacterBody3D (move_and_slide and test_move
; both go through body_test_motion); simulation covers thrown props and the rest of the
; rigid bodies so a crate does not snag on the same seams the player used to.
physics/jolt_physics_3d/motion_queries/use_enhanced_internal_edge_removal=true
physics/jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; ETC2/ASTC must stay ON, and it is NOT "the mobile format" here: Apple Silicon has no
; S3TC/BPTC, so a universal macOS build REQUIRES ASTC and the export refuses outright
; ("Cannot export for universal or arm64 if ETC2 ASTC texture format is disabled").
; Turning it off to save space broke the Mac build entirely.
; Per-BUILD size is handled where it belongs — in the export presets, which choose formats
; per platform (the Windows preset packs s3tc_bptc only). So both formats exist in the local
; import cache, but no single shipped build carries both.
textures/vram_compression/import_etc2_astc=true
; SHADOW QUALITY. All four of these were still on Godot's desktop defaults (4096 maps,
; medium PCF) — defaults chosen for a Forward+ desktop GPU, not for a Compatibility/GL
; build whose stated target is a MacBook. Measured with tests/FrameAttrib.tscn, the sun's
; shadow pass alone is 31-42% of EVERY draw call in the frame (658 of 2147 at the wet
; deck, 1036 of 2447 on the topside deck), and the maps it renders into were 4x larger
; than the geometry can use.
;
; The CASTER CULL (sun max_distance 45 m, 2 splits, render_budget.gd's 2-light positional
; cap) is what costs DRAW CALLS, and it stays exactly where it was measured. Map RESOLUTION
; costs depth-only fill and no draw calls at all, so on a draw-call-bound GL renderer it is
; the cheap half of the shadow budget — and it is the half that decides whether an edge
; reads as an edge or as a staircase. Both maps are 4096 (2026-07-27), paid for by putting
; the positional cap back to 2 after the 3-caster experiment made shadows visibly blockier.
;   directional: 4096 over the 45 m cascade = ~91 texels/metre.
;   positional : 4096 atlas, quadranted below so each live caster gets 2048x2048 to itself.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
; ATLAS QUADRANTS — these numbers are the other half of render_budget.gd's SHADOW_BUDGET=2.
; The atlas is four quadrants and each subdiv says how many shadows that quadrant is cut
; into (1 = one shadow, 2 = four, 3 = sixteen...). Godot's defaults (2/2/3/4 = 4/4/16/64
; slots) are sized for a scene with dozens of casters and they are why raising the cap to 3
; made the SURVIVING shadows worse: more contenders, finer subdivision, smaller map each.
; With at most two casters, quadrants 0 and 1 hold exactly one shadow apiece — 2048x2048
; each, sixteen times the texels a slot carried before. Quadrants 2 and 3 stay subdivided as
; a spillover for anything that enrols before RenderBudget's first sweep rations it.
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_1_subdiv=1
lights_and_shadows/positional_shadow/atlas_quadrant_2_subdiv=2
lights_and_shadows/positional_shadow/atlas_quadrant_3_subdiv=2
; PCF tap count per shadowed fragment. gl_compatibility really does honour this — its scene
; shader carries SHADOW_MODE_PCF_5 / SHADOW_MODE_PCF_13 variants — unlike soft_shadow_size,
; SDFGI and volumetric fog, which are Forward+ only and silently ignored here.
;   POSITIONAL 1 -> 3 (Soft Medium, PCF_13). This is where the reclaimed third-caster budget
;   is spent. It is affordable precisely because the cap is 2: only fragments lit by the two
;   nearest fixtures (render_budget.gd's SHADOW_NEAR is 20 m) pay the extra taps, and at
;   2048 per light a 5-tap kernel over a texel that small was leaving a hard stepped edge.
;   DIRECTIONAL stays at 1 (PCF_5). The sun lights EVERY pixel on screen, so its tap count
;   is the one genuinely per-frame-global cost here; tests/FrameAttrib.tscn put the sun's
;   pass at 31-42% of all draw calls, and 4096 already smooths its edge by resolution.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
limits/opengl/max_renderable_lights=160
; max_lights_per_object is the size of the per-fragment light loop the GL shader runs on
; EVERY object, everywhere — it is not a budget that only bites when it is reached. It was
; raised to 16 (double Godot's default) so a corridor lined with fixtures would not drop
; one; measured with tests/PowerPerf.tscn, the accommodation corridor has 23 light volumes
; covering a single point once the breaker is closed, so the loop really was running the
; full 16 per fragment there. Back to 8: the renderer keeps the 8 strongest lights for each
; object, and the 9th-through-16th contribution on a given surface is not something you can
; see against seven others. Halves the worst-case fragment cost in exactly the lit interiors
; that got glitchy. max_renderable_lights stays at 160 — that one is a scene-wide cap, not a
; per-fragment cost, and the rig legitimately has 187 lights in it.
limits/opengl/max_lights_per_object=8
